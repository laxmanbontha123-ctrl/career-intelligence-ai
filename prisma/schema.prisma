generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                Int                @id @default(autoincrement())
  authUid           String             @unique
  name              String?
  email             String?            @unique
  phone             String?            @unique
  role              String             @default("student")
  authMethod        String?
  profileCompleted  Boolean            @default(false)
  targetRole        String?
  readinessScore    Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  learnerProfile    LearnerProfile?
  userSkills        UserSkill[]
  roadmapProgress   RoadmapProgress[]
  resumeAnalyses    ResumeAnalysis[]
  mentorMessages    MentorMessage[]
  interviewAttempts InterviewAttempt[]
  dailyMissions     DailyMission[]
  dailyCheckIns     DailyCheckIn[]
  missionAttempts   MissionAttempt[]
}

model EmailOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model LearnerProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  institution       String?
  degree            String?
  branch            String?
  currentYear       Int?
  cgpa              Float?
  graduationYear    Int?
  experienceLevel   String?
  preferredWorkMode String?
  location          String?
  bio               String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSkill {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  category  String
  level     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model RoadmapProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  taskKey     String
  skill       String
  phase       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskKey])
  @@index([userId])
}

model ResumeAnalysis {
  id              Int      @id @default(autoincrement())
  userId          Int
  resumeText      String   @db.LongText
  atsScore        Int
  matchedKeywords String   @db.Text
  missingKeywords String   @db.Text
  strengths       String   @db.Text
  suggestions     String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MentorMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String
  content   String   @db.LongText
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model InterviewAttempt {
  id           Int      @id @default(autoincrement())
  userId       Int
  targetRole   String
  difficulty   String
  question     String   @db.Text
  answer       String   @db.LongText
  score        Int
  strengths    String   @db.Text
  improvements String   @db.Text
  idealAnswer  String   @db.LongText
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DailyMission {
  id               Int       @id @default(autoincrement())
  userId           Int
  dateKey          String    @db.VarChar(10)
  missionKey       String    @db.VarChar(120)
  category         String
  title            String
  description      String    @db.Text
  actionUrl        String?
  priority         Int       @default(2)
  estimatedMinutes Int       @default(20)
  completed        Boolean   @default(false)
  completedAt      DateTime?
  startedAt        DateTime?
  verifiedAt       DateTime?
  verificationMode String    @default("LEARNING_QUIZ")
  requiredScore    Int       @default(80)
  bestScore        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  learningContent MissionLearningContent?
  attempts        MissionAttempt[]

  @@unique([userId, dateKey, missionKey])
  @@index([userId, dateKey])
  @@index([userId, completed])
}

model DailyCheckIn {
  id               Int      @id @default(autoincrement())
  userId           Int
  dateKey          String   @db.VarChar(10)
  availableMinutes Int      @default(60)
  energyLevel      Int      @default(3)
  focusNote        String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId, dateKey])
}

model MissionLearningContent {
  id               Int      @id @default(autoincrement())
  missionId        Int      @unique
  lessonTitle      String
  objectivesJson   String   @db.Text
  lessonMarkdown   String   @db.LongText
  practiceMarkdown String   @db.LongText
  quizJson         String   @db.LongText
  sourcesJson      String?  @db.LongText
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mission DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model MissionAttempt {
  id          Int      @id @default(autoincrement())
  missionId   Int
  userId      Int
  answersJson String   @db.LongText
  score       Int
  passed      Boolean  @default(false)
  feedback    String   @db.Text
  createdAt   DateTime @default(now())

  mission DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([missionId, createdAt])
  @@index([userId, createdAt])
}
